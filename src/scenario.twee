:: StoryJavaScript [script]
/* Focus management: after each passage renders, move focus to its heading so
   screen readers announce the new passage title (WCAG 2.4.3). The heading gets
   tabindex="-1" so it can receive programmatic focus. The focus call retries
   briefly (render timing differs between first load and in-story navigation)
   and is re-applied once after window load; behavior is verified by the scripted
   Playwright tests in tests/scenario-tests.mjs. */
function focusPassageHeading() {
  var tries = 0;
  (function attempt() {
    var el = document.querySelector('#passages .passage:last-of-type');
    var heading = el && el.querySelector('h2, h1');
    if (heading) {
      if (!heading.hasAttribute('tabindex')) {
        heading.setAttribute('tabindex', '-1');
      }
      heading.focus({ preventScroll: true });
    } else if (++tries < 10) {
      window.setTimeout(attempt, 60);
    }
  })();
}
$(document).on(':passagedisplay', function () {
  window.setTimeout(focusPassageHeading, 0);
});
window.addEventListener('load', function () {
  window.setTimeout(focusPassageHeading, 0);
});
/* First-load safety net: SugarCube's opening display does not always emit
   :passagedisplay, so a few early attempts guarantee the opening passage gets
   focus even on a cold load or a session restore. */
[0, 300, 900].forEach(function (delay) {
  window.setTimeout(focusPassageHeading, delay);
});

